{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipmunk.local/contracts/v1/patch-artifact.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_sha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "patch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$"
          },
          "before_sha256": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_sha256": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "before_mode": {
            "anyOf": [
              {
                "enum": [
                  "100644",
                  "100755"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "after_mode": {
            "anyOf": [
              {
                "enum": [
                  "100644",
                  "100755"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "before_sha256",
          "after_sha256",
          "before_mode",
          "after_mode"
        ],
        "additionalProperties": false
      },
      "maxItems": 200,
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "error"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "command",
          "status",
          "summary"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "protocol_version",
    "sha256",
    "base_sha",
    "patch",
    "changed_files",
    "tests"
  ],
  "additionalProperties": false
}
