{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipmunk.local/contracts/v1/result.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 26,
      "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 26,
      "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "fence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "outcome": {
      "enum": [
        "findings",
        "no_findings",
        "changes_proposed",
        "incomplete",
        "needs_input"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "side": {
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "path",
          "line",
          "side",
          "severity",
          "explanation",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "patch_artifact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 26,
              "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifact_id",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "error"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "command",
          "status",
          "summary"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "cached_input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "input_tokens",
            "cached_input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "attempt_id",
    "fence",
    "summary",
    "outcome",
    "findings",
    "patch_artifact",
    "tests",
    "usage"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "patch_artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          },
          "patch_artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "changes_proposed"
          }
        }
      },
      "then": {
        "properties": {
          "patch_artifact": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 26,
                "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "artifact_id",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
