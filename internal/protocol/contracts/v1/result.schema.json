{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipmunk.local/contracts/v1/result.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 26,
      "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 26,
      "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "fence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "outcome": {
      "enum": [
        "findings",
        "no_findings",
        "changes_proposed",
        "incomplete",
        "needs_input"
      ]
    },
    "charter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "pattern": "^[0-9]+$",
      "enum": [
        "1"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "correctness",
              "security",
              "contract",
              "maintenance",
              "test_adequacy",
              "performance",
              "other"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "relation": {
            "enum": [
              "introduced",
              "modified",
              "preexisting"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "anchor": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "#/$defs/repository_path"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "side": {
                "enum": [
                  "LEFT",
                  "RIGHT"
                ]
              }
            },
            "required": [
              "path",
              "line",
              "side"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "category",
          "severity",
          "relation",
          "scenario",
          "consequence",
          "action",
          "explanation",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "why_material": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "required": [
          "topic",
          "question",
          "why_material"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "coverage": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "#/$defs/repository_path"
              },
              "status": {
                "enum": [
                  "reviewed",
                  "unreviewed"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "status"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unreviewed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                },
                "else": {
                  "properties": {
                    "reason": false
                  }
                }
              }
            ]
          },
          "maxItems": 300
        },
        "context_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 20
        }
      },
      "required": [
        "files",
        "context_gaps"
      ],
      "additionalProperties": false
    },
    "verification_state": {
      "enum": [
        "none"
      ]
    },
    "patch_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact_reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "error"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "command",
          "status",
          "summary"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "$ref": "#/$defs/token_count"
            },
            "cached_input_tokens": {
              "$ref": "#/$defs/token_count"
            },
            "output_tokens": {
              "$ref": "#/$defs/token_count"
            }
          },
          "required": [
            "input_tokens",
            "cached_input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "attempt_id",
    "fence",
    "summary",
    "outcome",
    "findings",
    "patch_artifact",
    "tests",
    "usage"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "patch_artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          },
          "patch_artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "changes_proposed"
          }
        }
      },
      "then": {
        "properties": {
          "patch_artifact": {
            "$ref": "#/$defs/artifact_reference"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "findings",
              "no_findings"
            ]
          }
        }
      },
      "then": {
        "required": [
          "charter_version",
          "coverage",
          "verification_state"
        ]
      },
      "else": {
        "properties": {
          "charter_version": false,
          "questions": false,
          "verification_state": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "changes_proposed",
              "needs_input"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "coverage": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "incomplete",
              "needs_input"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "$ref": "#/$defs/repository_path"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "snapshot",
        "path",
        "line_start",
        "line_end"
      ],
      "additionalProperties": false
    },
    "artifact_reference": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 26,
          "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "token_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
