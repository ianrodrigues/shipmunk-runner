#!/usr/bin/env php
<?php

declare(strict_types=1);

use Shipmunk\Runner\AttemptStateStore;
use Shipmunk\Runner\DockerSandbox;
use Shipmunk\Runner\Drivers\AgentSessionStore;
use Shipmunk\Runner\Drivers\CodexSandbox;
use Shipmunk\Runner\Drivers\CodexWatchdog;
use Shipmunk\Runner\FakeNativeExecutableAdapter;
use Shipmunk\Runner\HostWatchdog;
use Shipmunk\Runner\HttpControlPlaneClient;
use Shipmunk\Runner\NormalizedExecutionAdapter;
use Shipmunk\Runner\RunCommand;
use Shipmunk\Runner\Supervisor;
use Shipmunk\Runner\WorkspacePreparer;

require dirname(__DIR__).'/bootstrap.php';

if (! extension_loaded('pcntl')) {
    fwrite(STDERR, "The PHP pcntl extension is required for the independent host watchdog.\n");
    exit(2);
}

$options = getopt('', [
    'base-url:', 'token-file:', 'state-dir:', 'image:', 'once',
    'driver:', 'profiles-dir:', 'repository-image:',
]);

foreach (['base-url', 'token-file', 'state-dir', 'image'] as $required) {
    if (! is_string($options[$required] ?? null) || $options[$required] === '') {
        fwrite(STDERR, "Missing required --{$required} option.\n");
        exit(2);
    }
}

$tokenFile = $options['token-file'];
$mode = fileperms($tokenFile);

if ($mode === false || ($mode & 0o077) !== 0) {
    fwrite(STDERR, "Runner token file must not be accessible by group or other users.\n");
    exit(2);
}

$token = trim((string) file_get_contents($tokenFile));
$stateDirectory = rtrim($options['state-dir'], '/');
$driver = $options['driver'] ?? 'fixture';

if (! in_array($driver, ['fixture', 'codex'], true)) {
    fwrite(STDERR, "Unsupported runner driver.\n");
    exit(2);
}

if ($driver === 'codex' && (! is_string($options['profiles-dir'] ?? null) || $options['profiles-dir'] === '')) {
    fwrite(STDERR, "Codex requires an explicit protected --profiles-dir.\n");
    exit(2);
}

$supervisor = new Supervisor(
    new HttpControlPlaneClient($options['base-url'], $token),
    $driver === 'codex' ? new CodexSandbox(
        $options['profiles-dir'],
        $options['image'],
        $options['repository-image'] ?? $options['image'],
        new AgentSessionStore($stateDirectory.'/sessions'),
    ) : new DockerSandbox($options['image']),
    $driver === 'codex' ? new NormalizedExecutionAdapter : new FakeNativeExecutableAdapter,
    new AttemptStateStore($stateDirectory.'/active-attempt.json'),
    new WorkspacePreparer($stateDirectory.'/workspaces'),
    watchdog: $driver === 'codex' ? new CodexWatchdog : new HostWatchdog,
);

exit((new RunCommand($supervisor))->run(isset($options['once'])));
