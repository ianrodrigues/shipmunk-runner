#!/usr/bin/env php
<?php

declare(strict_types=1);

use Shipmunk\Runner\Profiles\DockerProfileRuntime;
use Shipmunk\Runner\Profiles\HttpProfileControlPlane;
use Shipmunk\Runner\Profiles\ProfileLifecycle;
use Shipmunk\Runner\Profiles\ProfileStore;

require dirname(__DIR__).'/bootstrap.php';

$options = getopt('', ['base-url:', 'token-file:', 'profiles-dir:', 'image:', 'profile:', 'operation:', 'operation-id:']);
try {
    foreach (['base-url', 'token-file', 'profiles-dir', 'image', 'profile', 'operation', 'operation-id'] as $required) {
        if (! is_string($options[$required] ?? null) || $options[$required] === '') {
            throw new RuntimeException('Missing required --'.$required.' option.');
        }
    }
    if ($options['operation'] === 'login' && (! stream_isatty(STDIN) || ! stream_isatty(STDOUT) || ! stream_isatty(STDERR))) {
        throw new RuntimeException('Native login requires an operator terminal.');
    }
    ProfileStore::protect($options['token-file']);
    $token = trim((string) file_get_contents($options['token-file']));
    $lifecycle = new ProfileLifecycle(
        new HttpProfileControlPlane($options['base-url'], $token),
        new DockerProfileRuntime($options['image']),
        diagnostic: static function (string $stage): void {
            fwrite(STDERR, 'Profile operation failed at stage: '.$stage.".\n");
        },
    );
    $result = $lifecycle->operate(
        new ProfileStore($options['profiles-dir'], $options['profile']),
        $options['profile'],
        $options['operation'],
        $options['operation-id'],
    );
    fwrite(STDOUT, json_encode($result, JSON_THROW_ON_ERROR)."\n");
    exit(in_array($result['health'], ['ready', 'disconnected'], true) ? 0 : 1);
} catch (Throwable) {
    // Never forward provider output, transport bodies or filesystem paths to audit/log collection.
    fwrite(STDERR, "Profile operation failed; protected recovery state was retained when needed.\n");
    exit(1);
}
