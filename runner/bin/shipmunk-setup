#!/usr/bin/env bash
set -euo pipefail
runner_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
runner_php="${PHP_BIN:-}"
if [[ -z "$runner_php" ]]; then
    for runner_candidate in "$(command -v php || true)" /opt/homebrew/opt/php@8.5/bin/php /usr/local/opt/php@8.5/bin/php; do
        if [[ -x "$runner_candidate" ]] && "$runner_candidate" -r 'exit(PHP_VERSION_ID >= 80500 && extension_loaded("pcntl") && extension_loaded("posix") ? 0 : 1);' >/dev/null 2>&1; then
            runner_php="$runner_candidate"
            break
        fi
    done
fi
if [[ -z "$runner_php" ]]; then
    echo 'Install PHP 8.5+ with pcntl and posix, then retry. Or set PHP_BIN=/path/to/php before this command.' >&2
    exit 2
fi
exec "$runner_php" "$runner_directory/setup.php" "$@"
