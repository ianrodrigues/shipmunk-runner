{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Your assessment of the change. At most 16384 characters and never empty."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "findings",
        "no_findings",
        "changes_proposed",
        "incomplete",
        "needs_input"
      ]
    },
    "charter_version": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "1",
        null
      ],
      "description": "\"1\" when outcome is findings or no_findings. Null for every other outcome."
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "contract",
              "maintenance",
              "test_adequacy",
              "performance",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "pattern": "^[^\\r\\n]+$",
            "description": "Between 5 and 80 characters, on one line, never empty."
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "relation": {
            "type": "string",
            "enum": [
              "introduced",
              "modified",
              "preexisting"
            ]
          },
          "scenario": {
            "type": "string",
            "description": "At most 2000 characters and never empty."
          },
          "consequence": {
            "type": "string",
            "description": "At most 2000 characters and never empty."
          },
          "action": {
            "type": "string",
            "description": "At most 2000 characters and never empty."
          },
          "explanation": {
            "type": "string",
            "description": "At most 8192 characters and never empty."
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "anchor": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "$ref": "#/$defs/repository_path"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "LEFT",
                      "RIGHT"
                    ]
                  }
                },
                "required": [
                  "path",
                  "line",
                  "side"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Presentation only. Null when no single line is worth highlighting."
          }
        },
        "required": [
          "category",
          "title",
          "severity",
          "relation",
          "scenario",
          "consequence",
          "action",
          "explanation",
          "evidence",
          "anchor"
        ],
        "additionalProperties": false
      },
      "description": "Empty for every outcome except findings."
    },
    "questions": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string",
                "description": "At most 200 characters and never empty."
              },
              "question": {
                "type": "string",
                "description": "At most 2000 characters and never empty."
              },
              "why_material": {
                "type": "string",
                "description": "At most 2000 characters and never empty."
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "$ref": "#/$defs/evidence"
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Null when the question cites nothing."
              }
            },
            "required": [
              "topic",
              "question",
              "why_material",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Null for every outcome except findings and no_findings."
    },
    "coverage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "maxItems": 300,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "$ref": "#/$defs/repository_path"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "reviewed",
                      "unreviewed"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Why the file is unreviewed, at most 500 characters. Null when status is reviewed."
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "$ref": "#/$defs/evidence"
                    },
                    "description": "Citations inspected while enumerating this file. Empty only when no citable text was available."
                  }
                },
                "required": [
                  "path",
                  "status",
                  "reason",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "description": "Every planned changed file, and nothing else."
            },
            "context_gaps": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "description": "At most 500 characters and never empty."
              }
            }
          },
          "required": [
            "files",
            "context_gaps"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Null for every outcome except findings, no_findings and incomplete."
    },
    "verification_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none",
        null
      ],
      "description": "\"none\" when outcome is findings or no_findings. Null for every other outcome."
    },
    "tests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "At most 2048 characters and never empty."
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run",
              "error"
            ]
          },
          "summary": {
            "type": "string",
            "description": "At most 4096 characters and never empty."
          }
        },
        "required": [
          "command",
          "status",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "outcome",
    "charter_version",
    "findings",
    "questions",
    "coverage",
    "verification_state",
    "tests"
  ],
  "additionalProperties": false,
  "$defs": {
    "repository_path": {
      "type": "string",
      "description": "Repository-relative path, at most 1024 characters. No leading slash, no \"..\" segment and no backslash."
    },
    "evidence": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "description": "The 40-character lowercase hexadecimal SHA of the snapshot you read."
        },
        "path": {
          "$ref": "#/$defs/repository_path"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "description": "First cited line."
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "description": "Last cited line, at or after line_start."
        },
        "reason": {
          "type": "string",
          "description": "One short sentence explaining what this reference shows, at most 500 characters."
        }
      },
      "required": [
        "snapshot",
        "path",
        "line_start",
        "line_end",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
